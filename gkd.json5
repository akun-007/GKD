{
  id: 1700000001,
  name: '开屏广告跳过规则',
  version: 3,
  author: 'liuyongkun',
  checkUpdateUrl: './gkd.version.json5',
  supportUri: 'https://github.com/akun-007/GKD',
  categories: [
    {
      key: 0,
      name: '广告',
    },
  ],
  globalGroups: [
    {
      key: 0,
      name: '开屏广告',
      desc: '匹配应用启动时常见的跳过按钮。',
      enable: true,
      fastQuery: true,
      matchTime: 10000,
      actionMaximum: 1,
      resetMatch: 'app',
      actionCd: 1000,
      rules: [
        {
          key: 0,
          name: '跳过',
          matches: '[text*="跳过"][text.length<10][visibleToUser=true]',
        },
        {
          key: 1,
          name: '跳过广告',
          matches: '[text*="跳过广告"][text.length<12][visibleToUser=true]',
        },
        {
          key: 2,
          name: '倒计时跳过',
          matches: '[text~="^([0-9]+\\s*)?跳过(广告)?$" || desc~="^([0-9]+\\s*)?跳过(广告)?$"][visibleToUser=true]',
        },
        {
          key: 3,
          name: 'Skip',
          matches: '[text~="(?i)^skip$" || desc~="(?i)^skip$"][visibleToUser=true]',
        },
      ],
    },
  ],
  apps: [
    {
      id: 'com.tencent.qqlive',
      name: '腾讯视频',
      groups: [
        {
          key: 0,
          name: '开屏广告',
          desc: '腾讯视频启动广告跳过按钮。',
          enable: true,
          fastQuery: true,
          matchTime: 10000,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              key: 0,
              name: '按控件 ID 匹配',
              matches: '[id="com.tencent.qqlive:id/skip_view"][visibleToUser=true]',
            },
            {
              key: 1,
              name: '按文本匹配',
              matches: '[text*="跳过"][visibleToUser=true]',
            },
          ],
        },
      ],
    },
    {
      id: 'com.dayunlinks.cloudbirds',
      name: '千鸟物联',
      groups: [
        {
          key: 0,
          name: '广告-进入首页后的弹窗',
          desc: '关闭进入首页后出现的小弹窗广告，点击弹窗右上角的叉号。',
          enable: true,
          matchTime: 30000,
          actionMaximum: 1,
          resetMatch: 'app',
          rules: [
            {
              key: 0,
              name: '按叉号或关闭描述匹配',
              matches: '[text~="^(×|✕|✖|X|x)$" || desc~="(?i)^(关闭|close|dismiss)$"][clickable=true][visibleToUser=true][width<200][height<200]',
            },
            {
              key: 1,
              name: '按关闭控件名称匹配',
              matches: '[vid~="(?i).*(close|dismiss|cancel).*"][clickable=true][visibleToUser=true][width<200][height<200]',
            },
          ],
        },
      ],
    },
  ],
}
